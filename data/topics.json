      "key": "eten",
      "label": "Eten en drinken",
      "brief": "Wat je moet proberen, hoe je veilig eet en wat je ongeveer betaalt voor ontbijt, lunch en diner."
    },
    {
      "key": "solo",
      "label": "Solo reizen",
      "brief": "Is het land geschikt om alleen te reizen, waar ontmoet je mensen en waar moet je extra op letten."
    },
    {
      "key": "met-kinderen",
      "label": "Met kinderen",
      "brief": "Wat werkt met kinderen, welke plekken te vermoeiend zijn en hoe je het tempo laag houdt."
    },
    {
      "key": "auto-huren",
      "label": "Auto huren",
      "brief": "Of huren verstandig is, wat een auto kost, welke verzekering je nodig hebt en de valkuilen op de weg."
    },
    {
      "key": "eilandhoppen",
      "label": "Eilandhoppen",
      "brief": "Hoe je tussen eilanden komt, wat boten kosten en hoe je voorkomt dat je hele dagen in de haven staat."
    },
    {
      "key": "eerste-keer",
      "label": "Eerste keer",
      "brief": "Wat je moet weten als je er nog nooit was: visa, geld, simkaart, gewoontes en de fouten die iedereen maakt."
    },
    {
      "key": "veiligheid",
      "label": "Veiligheid en gezondheid",
      "brief": "Realistische risico's, waar je op let, wat je regelt voor vertrek en wanneer je beter ergens niet heen gaat."
    },
